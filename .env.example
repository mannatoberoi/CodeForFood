# Copy this file to `.env` and fill in values.
# Vite only exposes variables prefixed with VITE_ to client-side code.

VITE_GROQ_API_KEY=

# Optional overrides (defaults are set in js/voice-agent.js)
# VITE_GROQ_MODEL=llama-3.1-8b-instant
# VITE_GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Supabase (used by js/supabase-client.js + pages/login.html via js/login-page.js)
# Project URL and anon key: Supabase Dashboard → Project Settings → API.
# Vercel: Project → Settings → Environment Variables → add both for Production
# (and Preview if you want). Redeploy after saving. Names must stay VITE_* so Vite embeds them at build time.
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# Database tables + RLS: run supabase/migrations/001_game_schema.sql in the Supabase SQL Editor once.
